# Copy to .env. Everything is optional; the README's Settings table explains each one.

# "open" lets anyone create an account. Otherwise only the first account can be created.
SIGNUP=

# Set to 1 when the server sits behind a reverse proxy.
TRUST_PROXY=

# Turns on photo logging and the weekly review.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Keep the data folder in an S3-compatible bucket (for hosts with no persistent disk).
MIRROR_ENDPOINT=
MIRROR_BUCKET=
MIRROR_REGION=
MIRROR_KEY_ID=
MIRROR_SECRET=
