# Copy to .env. Everything is optional; the README's Settings table explains each one.

# The exact address people use. Turns passkeys on. Example: https://thally.example.com
ORIGIN=

# Who may create an account after the first: invite (default), open, closed
SIGNUP=invite

# 0 removes "Use without an account"
ALLOW_GUEST=1

# Account IDs that are always admins, comma-separated (Settings -> Account -> Account ID)
ADMIN_UIDS=

# 1 when a reverse proxy in front overwrites X-Forwarded-For
TRUST_PROXY=

# 1 lets everyone's AI endpoints and webhooks reach home-network addresses
ALLOW_LAN=

# AI requests per person per day (each person uses their own provider and key)
AI_DAILY_LIMIT=40

# Activity log: AUDIT_LOG=0 turns it off; AUDIT_IP=net or full records addresses
AUDIT_LOG=1
AUDIT_IP=

# An e-mail push services can contact about this server's notifications
PUSH_CONTACT=

# Keep the data folder in an S3-compatible bucket (for hosts with no persistent disk)
MIRROR_ENDPOINT=
MIRROR_BUCKET=
MIRROR_REGION=
# A folder in the bucket, e.g. thally/, when the bucket is shared with another app
MIRROR_PREFIX=
MIRROR_KEY_ID=
MIRROR_SECRET=
